{
  // Server typecheck: src/ (including tests), scripts/ and the build config files.
  // The build uses tsconfig.build.json; the web UI has its own web/tsconfig.json.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,

    // For src/server/relayGateHook.mjs, the relay's gate hook: plain JavaScript,
    // so it runs from src/ under npm run dev, checked through its JSDoc.
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.mjs", "scripts/**/*.ts", "vite.config.ts", "vitest.config.ts"]
}
